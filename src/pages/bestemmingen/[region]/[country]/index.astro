---
import Layout from '../../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../../../lib/slug';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const pairs = new Map<string, { region: string; country: string }>();
  for (const post of posts) {
    const key = `${slugify(post.data.region)}/${slugify(post.data.country)}`;
    pairs.set(key, { region: post.data.region, country: post.data.country });
  }
  return Array.from(pairs.entries()).map(([key, data]) => {
    const [regionSlug, countrySlug] = key.split('/');
    return {
      params: { region: regionSlug, country: countrySlug },
      props: data,
    };
  });
}

const { region, country } = Astro.props;
const allPosts = await getCollection('posts');
const posts = allPosts.filter((p) => p.data.region === region && p.data.country === country);
---
<Layout title={country}>
  <div class="crumbs"><a href="/">Home</a> / <a href="/bestemmingen">Bestemmingen</a> / <a href={`/bestemmingen/${slugify(region)}/`}>{region}</a> / {country}</div>
  <h1 style="font-size: 40px; margin-bottom: 40px;">{country}</h1>
  <div class="grid">
    {posts.map((post) => (
      <a href={`/bestemmingen/${slugify(region)}/${slugify(country)}/${post.slug}/`} class="card">
        <div class={`img ${post.data.image ? 'has-photo' : ''}`} style={post.data.image ? `background-image: url(${post.data.image})` : ''}>
          <span>{post.data.title}</span>
        </div>
        <div class="body">
          <div class="tag">{post.data.region}</div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </div>
      </a>
    ))}
  </div>
</Layout>
