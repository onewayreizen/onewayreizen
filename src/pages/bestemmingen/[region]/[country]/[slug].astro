---
import Layout from '../../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../../../lib/slug';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: {
      region: slugify(post.data.region),
      country: slugify(post.data.country),
      slug: post.slug,
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const regionSlug = slugify(post.data.region);
const countrySlug = slugify(post.data.country);
---
<Layout title={post.data.title} heroImage={post.data.image}>
  <div class="crumbs">
    <a href="/">Home</a> / <a href="/bestemmingen">Bestemmingen</a> /
    <a href={`/bestemmingen/${regionSlug}/`}>{post.data.region}</a> /
    <a href={`/bestemmingen/${regionSlug}/${countrySlug}/`}>{post.data.country}</a>
  </div>
  <article class="article">
    <h1>{post.data.title}</h1>
    <div class="meta">{post.data.region} · {post.data.date}</div>
    <Content />
  </article>
</Layout>
