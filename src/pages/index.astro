---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../lib/slug';

const posts = await getCollection('posts');
const regionMap = new Map<string, { count: number; image?: string }>();
for (const post of posts) {
  const existing = regionMap.get(post.data.region);
  if (existing) {
    existing.count += 1;
    if (!existing.image && post.data.image) existing.image = post.data.image;
  } else {
    regionMap.set(post.data.region, { count: 1, image: post.data.image });
  }
}
const regions = Array.from(regionMap.entries()).map(([name, info]) => ({
  name,
  slug: slugify(name),
  ...info,
}));
---
<Layout title="Een reisblog zonder retourticket">
  <div style="padding: 30px 0 60px;">
    <div style="font-size: 14px; color: #4B5A3F; margin-bottom: 18px;">Een reisblog zonder retourticket</div>
    <h1 style="font-size: 52px; max-width: 720px; margin-bottom: 24px;">Een klein beetje van heel veel plekken</h1>
    <p style="font-size: 18px; color: #6B6255; max-width: 520px; margin-bottom: 32px;">Solo op pad langs 65+ landen, van drukke steden tot plekken waar bijna niemand komt. Praktische gidsen, eerlijke verhalen, geen poeha.</p>
  </div>

  <h2 style="font-size: 30px; margin-bottom: 40px;">Ontdek per regio</h2>
  <div class="grid">
    {regions.map((region) => (
      <a href={`/bestemmingen/${region.slug}/`} class="card">
        <div class={`img ${region.image ? 'has-photo' : ''}`} style={region.image ? `background-image: url(${region.image})` : ''}>
          <span>{region.name}</span>
        </div>
        <div class="body">
          <div class="tag">{region.count} {region.count === 1 ? 'bestemming' : 'bestemmingen'}</div>
          <h3>{region.name}</h3>
        </div>
      </a>
    ))}
  </div>

  <div id="over" style="padding-top: 70px;">
    <h2 style="font-size: 30px; margin-bottom: 24px;">Over mij</h2>
    <p style="max-width: 640px; font-size: 16px; color: #6B6255;">Al drie jaar onderweg, zonder vaste route en met een camera in de aanslag. Ik schrijf over de plekken waar ik kom, groot of klein, bekend of onbekend — met tips die je echt kunt gebruiken.</p>
  </div>
</Layout>
