---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import Spotlight from '../components/Spotlight.astro';
import Carousel from '../components/Carousel.astro';
import { getData, formatDate, kiesUitverschillendeLanden } from '../lib/content';
import { site } from '../data/site';

const { posts, themes } = await getData();

// "Jouw volgende avontuur": favoriete artikelen (featured: true), altijd uit
// verschillende landen, aangevuld met de nieuwste artikelen als er nog geen 4
// favorieten zijn gemarkeerd.
const avontuur = kiesUitverschillendeLanden(posts, 4);

// "Nieuwste verhalen": de 6 nieuwste artikelen van de site, in een carousel
const nieuwste = posts.slice(0, 6);

// "Reisgidsen": alle artikelen met themes: [Reisgidsen]
const reisgidsen = themes.find((t) => t.slug === 'reisgidsen');
---

<Layout>
  <Hero
    size="xl"
    eyebrow={site.tagline}
    title={site.home.title}
    text={site.home.text}
    center
  >
    <div class="hero__actions">
      <a class="btn btn--primary" href="/bestemmingen/">Ontdek bestemmingen</a>
      <a class="btn btn--ghost" href="/jouw-avontuur/">Jouw avontuur</a>
    </div>
  </Hero>

  {site.stats.length > 0 && (
    <div class="stats">
      <div class="container stats__inner">
        {site.stats.map((stat) => (
          <div class="stat">
            <span class="stat__value">{stat.value}</span>
            <span class="stat__label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  {avontuur.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head section-head--center">
          <p class="section-eyebrow">Waar ga je heen?</p>
          <h2 class="section-title">Jouw volgende avontuur</h2>
        </div>
        <div class="grid grid--home">
          {avontuur.map((post) => (
            <Card
              href={post.url}
              title={post.title}
              label={post.destination || post.country || post.region || 'Artikel'}
              text={post.description}
              meta={formatDate(post.date)}
              image={post.image}
              compact
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <Spotlight />

  {themes.length > 0 && (
    <section class="section section--dark">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title">{site.home.themesTitle}</h2>
        </div>
        <div class="chips">
          {themes.map((theme, i) => (
            <a class:list={['chip', `chip--${i % 3}`]} href={theme.url}>
              {theme.name}<span class="chip__count">{theme.posts.length}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {nieuwste.length > 0 && (
    <section class="section section--sand">
      <div class="container split">
        <div class="split__text">
          <p class="section-eyebrow">Vers van de pers</p>
          <h2 class="section-title">{site.home.latestTitle}</h2>
          <p class="split__lead">
            De laatste verhalen, tips en routes, rechtstreeks van onderweg.
          </p>
          <a class="btn btn--primary" href="/bestemmingen/">Bekijk alle bestemmingen</a>
        </div>
        <div class="split__carousel">
          <Carousel posts={nieuwste} id="nieuwste" split />
        </div>
      </div>
    </section>
  )}

  {reisgidsen && reisgidsen.posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head section-head--center">
          <p class="section-eyebrow">Praktisch en overzichtelijk</p>
          <h2 class="section-title">{reisgidsen.name}</h2>
        </div>
        <Carousel posts={reisgidsen.posts.slice(0, 10)} id="reisgidsen" />
        <div class="carousel-more">
          <a class="link-more" href="/reisgidsen/">Alle reisgidsen</a>
        </div>
      </div>
    </section>
  )}

  <section class="section" id="over">
    <div class="container about">
      <div class="about__photo" style={`--about-image: url('${site.about.image}')`}></div>
      <div class="about__text">
        <h2 class="section-title">{site.about.title}</h2>
        {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <p style="margin-top:1.6rem"><a class="link-more" href="/over-mij/">Lees verder</a></p>
      </div>
    </div>
  </section>
</Layout>
