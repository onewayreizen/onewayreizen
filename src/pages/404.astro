---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pagina niet gevonden" overlay={false}>
  <section class="section section--top">
    <div class="container">
      <h1 class="section-title">Deze pagina bestaat niet (meer)</h1>
      <p class="section-sub">De link is misschien verouderd of er zit een typfout in. Ga terug naar de homepage of zoek naar wat je zocht.</p>
      <div class="hero__actions" style="margin-top:1.8rem">
        <a class="btn btn--primary" href="/">Naar de homepage</a>
        <a class="btn" style="border-color:var(--line)" href="/zoeken/">Zoeken</a>
      </div>
    </div>
  </section>
</Layout>
