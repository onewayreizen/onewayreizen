---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { site } from '../data/site';
---

<Layout title={site.about.title} description={site.about.paragraphs[0]} image={site.about.image}>
  <Hero
    size="md"
    title={site.about.title}
    image={site.about.image}
    crumbs={[{ label: 'Home', href: '/' }, { label: site.about.title }]}
  />
  <section class="section">
    <div class="container">
      <div class="prose">
        {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>
</Layout>
