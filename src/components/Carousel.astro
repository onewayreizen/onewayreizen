---
// Horizontale kaarten-carousel met "peek" (de volgende kaart is deels zichtbaar),
// pijltjes, bolletjes en swipen. Gebruikt voor Reisgidsen en Nieuwste verhalen.
import Card from './Card.astro';
import type { Post } from '../lib/content';
import { formatDate } from '../lib/content';

interface Props {
  posts: Post[];
  id: string;
  // split: iets smallere kaarten, voor gebruik naast een tekstkolom (zie "Nieuwste verhalen")
  split?: boolean;
}
const { posts, id, split = false } = Astro.props;
---

<div class:list={['carousel', split && 'carousel--split']} data-carousel={id}>
  <div class="carousel__track" role="list">
    {posts.map((post) => (
      <div class="carousel__item" role="listitem">
        <Card
          href={post.url}
          title={post.title}
          label={post.destination || post.country || post.region || 'Artikel'}
          text={post.description}
          meta={formatDate(post.date)}
          image={post.image}
          compact
        />
      </div>
    ))}
  </div>

  {posts.length > 1 && (
    <div class="carousel__controls">
      <button class="carousel__arrow" type="button" data-dir="-1" aria-label="Vorige">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <!-- De bolletjes hieronder worden met JS gevuld: het aantal hangt af van
           hoeveel kaarten tegelijk zichtbaar zijn (dat verschilt per schermbreedte),
           niet van het totale aantal artikelen. -->
      <div class="carousel__dots" role="tablist" aria-label="Ga naar pagina"></div>
      <button class="carousel__arrow" type="button" data-dir="1" aria-label="Volgende">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  )}
</div>

<script>
  // Eén script werkt voor elke carousel op de pagina (data-carousel als anker)
  document.querySelectorAll('.carousel').forEach((carousel) => {
    const track = carousel.querySelector('.carousel__track');
    const items = Array.from(carousel.querySelectorAll('.carousel__item'));
    const dotsBox = carousel.querySelector('.carousel__dots');
    const arrows = carousel.querySelectorAll('.carousel__arrow');
    if (!track || !dotsBox || items.length === 0) return;

    let itemsPerPagina = 1;
    let aantalPaginas = 1;
    let dots = [];

    // Hoeveel kaarten passen er nu (bij deze schermbreedte) tegelijk in beeld?
    function meetItemsPerPagina() {
      const itemBreedte = items[0].getBoundingClientRect().width;
      const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || '0') || 0;
      const zichtbareBreedte = track.getBoundingClientRect().width;
      const per = Math.round((zichtbareBreedte + gap) / (itemBreedte + gap));
      return Math.max(1, Math.min(per, items.length));
    }

    function bouwDots() {
      itemsPerPagina = meetItemsPerPagina();
      aantalPaginas = Math.max(1, Math.ceil(items.length / itemsPerPagina));
      dotsBox.innerHTML = '';
      dots = [];
      for (let p = 0; p < aantalPaginas; p++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'carousel__dot';
        dot.setAttribute('aria-label', `Pagina ${p + 1}`);
        dot.addEventListener('click', () => scrollNaarPagina(p));
        dotsBox.appendChild(dot);
        dots.push(dot);
      }
    }

    function scrollNaarPagina(p) {
      const clamped = Math.max(0, Math.min(p, aantalPaginas - 1));
      const doelIndex = Math.min(clamped * itemsPerPagina, items.length - 1);
      items[doelIndex].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
    }

    function huidigePagina() {
      const trackLeft = track.getBoundingClientRect().left;
      let dichtsbij = 0;
      let kleinsteAfstand = Infinity;
      items.forEach((item, i) => {
        const afstand = Math.abs(item.getBoundingClientRect().left - trackLeft);
        if (afstand < kleinsteAfstand) {
          kleinsteAfstand = afstand;
          dichtsbij = i;
        }
      });
      return Math.min(Math.round(dichtsbij / itemsPerPagina), aantalPaginas - 1);
    }

    function updateDots() {
      const p = huidigePagina();
      dots.forEach((dot, di) => dot.classList.toggle('is-active', di === p));
    }

    arrows.forEach((arrow) => {
      arrow.addEventListener('click', () => {
        const dir = Number(arrow.getAttribute('data-dir'));
        scrollNaarPagina(huidigePagina() + dir);
      });
    });

    let ticking = false;
    track.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateDots();
          ticking = false;
        });
      },
      { passive: true },
    );

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        bouwDots();
        updateDots();
      }, 150);
    });

    bouwDots();
    updateDots();
  });
</script>
