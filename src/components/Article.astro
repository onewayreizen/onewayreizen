---
// De volledige artikelpagina. Wordt gebruikt voor artikelen met een land
// (/bestemmingen/...) en voor algemene artikelen zonder land (/artikelen/...).
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import Card from './Card.astro';
import { getData, formatDate } from '../lib/content';
import type { Post } from '../lib/content';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post.entry);
const { countries, regions, posts } = await getData();

const country = post.hasCountry
  ? countries.find((c) => c.slug === post.countrySlug && c.regionSlug === post.regionSlug)
  : undefined;
const countryName = country?.name ?? post.country;
const countryUrl = post.hasCountry ? `/bestemmingen/${post.regionSlug}/${post.countrySlug}/` : undefined;
const regionName = regions.find((r) => r.slug === post.regionSlug)?.name ?? post.region;
const firstTheme = post.themes[0];

// Broodkruimelpad bovenaan
const crumbs = [{ label: 'Home', href: '/' }];
if (post.regionSlug) {
  crumbs.push({ label: 'Bestemmingen', href: '/bestemmingen/' });
  crumbs.push({ label: regionName, href: `/bestemmingen/${post.regionSlug}/` });
} else if (firstTheme) {
  crumbs.push({ label: 'Jouw avontuur', href: '/jouw-avontuur/' });
  crumbs.push({ label: firstTheme.name, href: `/jouw-avontuur/${firstTheme.slug}/` });
}
if (post.hasCountry && countryUrl) crumbs.push({ label: countryName, href: countryUrl });

// Onderaan: meer verhalen uit hetzelfde land, of anders over hetzelfde thema
let related: Post[] = [];
let relatedTitle = '';
let endLink: { label: string; href: string } | undefined;
if (country && countryUrl) {
  related = country.posts.filter((p) => p.id !== post.id).slice(0, 3);
  relatedTitle = `Meer uit ${countryName}`;
  endLink = { label: `Meer verhalen over ${countryName}`, href: countryUrl };
} else if (firstTheme) {
  related = posts
    .filter((p) => p.id !== post.id && p.themes.some((t) => t.slug === firstTheme.slug))
    .slice(0, 3);
  relatedTitle = `Meer over ${firstTheme.name}`;
  endLink = { label: `Meer verhalen over ${firstTheme.name}`, href: `/jouw-avontuur/${firstTheme.slug}/` };
}
---

<Layout title={post.title} description={post.description} image={post.image} type="article">
  <Hero title={post.title} image={post.image} crumbs={crumbs}>
    <div class="hero__meta">
      <span>{formatDate(post.date)}</span>
      {countryUrl && <a href={countryUrl}>{countryName}</a>}
      {post.themes.map((theme) => (
        <a class="tag" href={`/jouw-avontuur/${theme.slug}/`}>{theme.name}</a>
      ))}
    </div>
  </Hero>

  <section class="section">
    <div class="container">
      <div class="prose" data-pagefind-body>
        <h2 class="article-title" data-pagefind-meta="title">{post.title}</h2>
        <Content />
      </div>
      {endLink && (
        <div class="article-end">
          <a class="link-more" href={endLink.href}>{endLink.label}</a>
        </div>
      )}
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section--sand">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title">{relatedTitle}</h2>
        </div>
        <div class="grid">
          {related.map((p) => (
            <Card
              href={p.url}
              title={p.title}
              label={p.destination || p.country || p.region || 'Artikel'}
              text={p.description}
              meta={formatDate(p.date)}
              image={p.image}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
