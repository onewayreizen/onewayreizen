---
// De kaart die overal op de site wordt hergebruikt
// (regio's, landen, artikelen en thema's)
interface Props {
  href: string;
  title: string;
  label?: string;
  text?: string;
  meta?: string;
  image?: string;
  dest?: string;
  // compact: kleinere kaart, gebruikt op de homepage (4 op een rij, carousel)
  compact?: boolean;
}
const { href, title, label, text, meta, image, dest, compact = false } = Astro.props;
const style = image ? `--card-image: url('${image}')` : undefined;
---

<a class:list={['card', compact && 'card--compact']} href={href} style={style} data-dest={dest}>
  <span class="card__bg"></span>
  <span class="card__body">
    {label && <span class="card__label">{label}</span>}
    <span class="card__title">{title}</span>
    {text && <span class="card__text">{text}</span>}
    {meta && <span class="card__meta">{meta}</span>}
  </span>
</a>

